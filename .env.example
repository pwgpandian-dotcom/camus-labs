# Supabase (Phase 5+ — client portal / admin auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI layer — Camus Learn uses whichever provider has a key (admin picks models in /admin/learn/ai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# Optional default model overrides used when falling back between providers
ANTHROPIC_MODEL=
OPENAI_MODEL=
GOOGLE_AI_MODEL=

# Public site URL (sitemap, canonical URLs, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://camus-labs.vercel.app

# Media (case study screenshots, marketing assets)
CLOUDINARY_URL=

# Never commit a real .env file. This file only documents the shape.
